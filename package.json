{
  "name": "vanehub-ai",
  "version": "0.1.0-preview.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint .",
    "build": "tsc && vite build && node scripts/check-frontend-chunks.mjs",
    "preview": "vite preview",
    "icons:generate": "node scripts/generate-vanehub-icon.mjs",
    "sidecar:prepare": "node scripts/prepare-permission-hook-sidecar.mjs",
    "sidecar:unit:test": "node --test scripts/prepare-permission-hook-sidecar.node-test.mjs",
    "desktop:unit:test": "node --test scripts/desktop-*.node-test.mjs",
    "tauri:dev": "npm run sidecar:prepare && tauri dev --config src-tauri/tauri.sidecar.conf.json",
    "tauri:build": "npm run sidecar:prepare -- --release && tauri build --config src-tauri/tauri.sidecar.conf.json",
    "package": "npm run sidecar:prepare -- --release && tauri build --config src-tauri/tauri.sidecar.conf.json",
    "package:windows:x64": "npm run sidecar:prepare -- --release --target=x86_64-pc-windows-msvc && tauri build --config src-tauri/tauri.sidecar.conf.json --target x86_64-pc-windows-msvc",
    "package:windows:arm64": "npm run sidecar:prepare -- --release --target=aarch64-pc-windows-msvc && tauri build --config src-tauri/tauri.sidecar.conf.json --target aarch64-pc-windows-msvc",
    "package:macos:x64": "npm run sidecar:prepare -- --release --target=x86_64-apple-darwin && tauri build --config src-tauri/tauri.sidecar.conf.json --target x86_64-apple-darwin",
    "package:macos:arm64": "npm run sidecar:prepare -- --release --target=aarch64-apple-darwin && tauri build --config src-tauri/tauri.sidecar.conf.json --target aarch64-apple-darwin",
    "package:linux:x64": "npm run sidecar:prepare -- --release --target=x86_64-unknown-linux-gnu && tauri build --config src-tauri/tauri.sidecar.conf.json --target x86_64-unknown-linux-gnu",
    "package:linux:arm64": "npm run sidecar:prepare -- --release --target=aarch64-unknown-linux-gnu && tauri build --config src-tauri/tauri.sidecar.conf.json --target aarch64-unknown-linux-gnu",
    "version:check": "node scripts/check-version-sync.mjs",
    "version:unit:test": "node --test scripts/check-version-sync.node-test.mjs",
    "test": "vitest run",
    "test:desktop:build": "node scripts/test-desktop.mjs build",
    "test:desktop:smoke": "node scripts/test-desktop.mjs smoke",
    "test:desktop": "node scripts/test-desktop.mjs all",
    "test:verify": "node scripts/test-verify.mjs",
    "test:coverage": "vitest run --coverage --maxWorkers=4 --testTimeout=15000",
    "coverage:check:frontend": "node scripts/check-coverage-policy.mjs --kind frontend --report coverage/frontend/coverage-summary.json",
    "coverage:native": "node scripts/run-native-coverage.mjs",
    "coverage:check:native": "node scripts/check-coverage-policy.mjs --kind native --report coverage/native/coverage.json",
    "coverage:policy:test": "node --test scripts/check-coverage-policy.node-test.mjs",
    "lint:ci": "eslint . --max-warnings=0",
    "contracts:check": "vitest run src/contracts/contract-conformance.test.ts",
    "architecture:check": "node --test scripts/architecture/*.node-test.mjs && node scripts/architecture/check.mjs && npm run lint:ci && tsc --noEmit && cargo test --manifest-path src-tauri/Cargo.toml --test architecture",
    "docs:unit:test": "node --test scripts/check-readme-parity.node-test.mjs scripts/docs-screenshot-port.node-test.mjs scripts/validate-docs.node-test.mjs",
    "docs:readme:check": "node scripts/check-readme-parity.mjs",
    "docs:links:check": "node scripts/validate-docs.mjs",
    "docs:check": "npm run docs:unit:test && npm run docs:readme:check && npm run docs:links:check",
    "docs:test": "node scripts/test-docs.mjs",
    "docs:build": "node scripts/build-docs.mjs",
    "docs:screenshots:update": "node scripts/run-doc-screenshots.mjs update",
    "docs:screenshots:check": "node scripts/run-doc-screenshots.mjs check",
    "prepare": "husky"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.9",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "highlight.js": "~11.11.0",
    "i18next": "^26.3.6",
    "katex": "^0.18.1",
    "lucide-react": "^1.29.0",
    "mermaid": "^11.16.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.2",
    "react-hook-form": "^7.84.0",
    "react-i18next": "^17.0.11",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "@wdio/cli": "9.30.1",
    "@wdio/local-runner": "9.30.1",
    "@wdio/mocha-framework": "9.30.1",
    "@wdio/spec-reporter": "9.30.1",
    "@wdio/tauri-plugin": "1.3.0",
    "@wdio/tauri-service": "1.3.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "expect-webdriverio": "5.6.5",
    "husky": "^9.1.7",
    "jsdom": "30.0.1",
    "lint-staged": "^17.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.2": true
  }
}
