{
  "name": "vanehub-ai",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint .",
    "build": "tsc && vite build && node scripts/check-frontend-chunks.mjs",
    "preview": "vite preview",
    "icons:generate": "node scripts/generate-vanehub-icon.mjs",
    "sidecar:prepare": "node scripts/prepare-permission-hook-sidecar.mjs",
    "sidecar:unit:test": "node --test scripts/prepare-permission-hook-sidecar.node-test.mjs",
    "desktop:unit:test": "node --test scripts/desktop-*.node-test.mjs",
    "tauri:dev": "npm run sidecar:prepare && tauri dev --config src-tauri/tauri.sidecar.conf.json",
    "tauri:build": "npm run sidecar:prepare -- --release && tauri build --config src-tauri/tauri.sidecar.conf.json",
    "package": "npm run sidecar:prepare -- --release && tauri build --config src-tauri/tauri.sidecar.conf.json",
    "package:windows:x64": "npm run sidecar:prepare -- --release --target=x86_64-pc-windows-msvc && tauri build --config src-tauri/tauri.sidecar.conf.json --target x86_64-pc-windows-msvc",
    "package:windows:arm64": "npm run sidecar:prepare -- --release --target=aarch64-pc-windows-msvc && tauri build --config src-tauri/tauri.sidecar.conf.json --target aarch64-pc-windows-msvc",
    "package:macos:x64": "npm run sidecar:prepare -- --release --target=x86_64-apple-darwin && tauri build --config src-tauri/tauri.sidecar.conf.json --target x86_64-apple-darwin",
    "package:macos:arm64": "npm run sidecar:prepare -- --release --target=aarch64-apple-darwin && tauri build --config src-tauri/tauri.sidecar.conf.json --target aarch64-apple-darwin",
    "package:linux:x64": "npm run sidecar:prepare -- --release --target=x86_64-unknown-linux-gnu && tauri build --config src-tauri/tauri.sidecar.conf.json --target x86_64-unknown-linux-gnu",
    "package:linux:arm64": "npm run sidecar:prepare -- --release --target=aarch64-unknown-linux-gnu && tauri build --config src-tauri/tauri.sidecar.conf.json --target aarch64-unknown-linux-gnu",
    "version:check": "node scripts/check-version-sync.mjs",
    "version:unit:test": "node --test scripts/check-version-sync.node-test.mjs",
    "release:unit:test": "node --test scripts/release-policy.node-test.mjs",
    "test": "vitest run --maxWorkers=4",
    "test:desktop:build": "node scripts/test-desktop.mjs build",
    "test:desktop:smoke": "node scripts/test-desktop.mjs smoke",
    "test:desktop:cli-terminal": "node scripts/test-desktop.mjs cli-terminal",
    "test:desktop:cli-management": "node scripts/test-desktop.mjs cli-management",
    "test:desktop:session-workspace": "node scripts/test-desktop.mjs session-workspace",
    "test:desktop:session-shell": "node scripts/test-desktop.mjs session-shell",
    "test:desktop:dialogs": "node scripts/test-desktop.mjs dialogs",
    "test:desktop:scheduled-tasks": "node scripts/test-desktop.mjs scheduled-tasks",
    "test:desktop:settings-persistence": "node scripts/test-desktop.mjs settings-persistence",
    "test:desktop:agent-mcp": "node scripts/test-desktop.mjs agent-mcp",
    "test:desktop:agent-evaluation": "node scripts/test-desktop.mjs agent-evaluation",
    "test:desktop:agent-evaluation:live-opencode": "node scripts/test-desktop.mjs agent-evaluation-live-opencode",
    "test:desktop:agent-evaluation:live-onepiece": "node scripts/test-desktop.mjs agent-evaluation-live-onepiece",
    "test:desktop:local-media": "node scripts/test-desktop.mjs local-media",
    "test:desktop:skills": "node scripts/test-desktop.mjs skills",
    "test:desktop:feishu-im": "node scripts/test-desktop.mjs feishu-im",
    "test:desktop:feishu-live": "node scripts/test-desktop.mjs feishu-live",
    "test:desktop:multi-agent-requirement": "node scripts/test-desktop.mjs multi-agent-requirement",
    "test:desktop:multi-agent-longrun": "node scripts/test-desktop.mjs multi-agent-longrun",
    "test:desktop:loop": "node scripts/test-desktop.mjs loop",
    "test:desktop": "node scripts/test-desktop.mjs all",
    "test:verify": "node scripts/test-verify.mjs",
    "local-media:python:test": "node scripts/test-local-media-python.mjs",
    "local-media:e2e": "playwright test --config playwright.local-media.config.ts",
    "local-media:fake:check": "node scripts/check-local-media-fake-bundle.mjs",
    "test:coverage": "vitest run --coverage --maxWorkers=2 --testTimeout=15000",
    "coverage:check:frontend": "node scripts/check-coverage-policy.mjs --kind frontend --report coverage/frontend/coverage-summary.json",
    "coverage:native": "node scripts/run-native-coverage.mjs",
    "coverage:check:native": "node scripts/check-coverage-policy.mjs --kind native --report coverage/native/coverage.json",
    "coverage:policy:test": "node --test scripts/check-coverage-policy.node-test.mjs",
    "lint:ci": "eslint . --max-warnings=0",
    "contracts:generate": "node scripts/generate-cli-parameter-catalog.mjs && node scripts/generate-cli-parameter-matrix.mjs",
    "docs:matrix:generate": "node scripts/generate-cli-parameter-matrix.mjs",
    "contracts:check": "node scripts/generate-cli-parameter-catalog.mjs --check && node scripts/generate-cli-parameter-matrix.mjs --check && vitest run src/contracts/contract-conformance.test.ts src/contracts/cli-parameter-contract.test.ts src/contracts/cli-parameter-localization.test.ts",
    "architecture:check": "node --test scripts/architecture/*.node-test.mjs && node scripts/architecture/check.mjs && npm run lint:ci && tsc --noEmit && cargo test --manifest-path src-tauri/Cargo.toml --test architecture --test session_shell_architecture --test session_log_index_architecture --test log_repair_boundaries",
    "native:panic:check": "cargo clippy --workspace --lib --bins -- -D clippy::unwrap_used -D clippy::expect_used",
    "performance:unit:test": "node --test scripts/performance/*.node-test.mjs",
    "performance:check": "npm run performance:unit:test && node scripts/performance/cli.mjs check",
    "performance:benchmark": "node scripts/performance/cli.mjs benchmark",
    "docs:unit:test": "node --test scripts/check-readme-parity.node-test.mjs scripts/docs-screenshot-port.node-test.mjs scripts/validate-docs.node-test.mjs",
    "docs:readme:check": "node scripts/check-readme-parity.mjs",
    "docs:links:check": "node scripts/validate-docs.mjs",
    "docs:check": "npm run docs:unit:test && npm run docs:readme:check && npm run docs:links:check",
    "docs:test": "node scripts/test-docs.mjs",
    "docs:build": "node scripts/build-docs.mjs",
    "docs:screenshots:update": "node scripts/run-doc-screenshots.mjs update",
    "docs:screenshots:check": "node scripts/run-doc-screenshots.mjs check",
    "prepare": "husky",
    "test:desktop:core-smoke": "node scripts/test-desktop.mjs core-smoke",
    "test:desktop:external-provider": "node scripts/test-desktop.mjs external-provider",
    "test:desktop:all": "node scripts/test-desktop.mjs everything"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.10",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "highlight.js": "~11.12.0",
    "i18next": "^26.4.0",
    "katex": "^0.18.4",
    "lucide-react": "^1.33.0",
    "mermaid": "^11.17.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.3",
    "react-i18next": "^17.0.12",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "@wdio/cli": "9.31.1",
    "@wdio/local-runner": "9.31.1",
    "@wdio/mocha-framework": "9.31.1",
    "@wdio/spec-reporter": "9.31.1",
    "@wdio/tauri-plugin": "1.3.0",
    "@wdio/tauri-service": "1.3.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "expect-webdriverio": "6.0.5",
    "husky": "^9.1.7",
    "jsdom": "30.0.1",
    "lint-staged": "^17.3.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.2": true
  },
  "overrides": {
    "@wdio/config": {
      "glob": "10.5.0"
    },
    "@wdio/utils": {
      "@puppeteer/browsers": "3.2.0"
    },
    "archiver-utils": {
      "glob": "10.5.0"
    },
    "mocha": {
      "serialize-javascript": "7.0.5"
    },
    "nanoid": "3.3.18"
  }
}
