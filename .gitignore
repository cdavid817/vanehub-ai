node_modules/
dist/
.vanehub/
.idea/
src-tauri/target/
# Cargo puts the target directory at the workspace root once src-tauri is a member.
/target/
src-tauri/binaries/
.cargo-target-code-index/
*.log
test-results/
playwright-report/
coverage/
.docs-build/
.docs-target/
.docs-screenshots/
# one-off UX audit captures (docs/ux-audit-report.md references these locally)
.ux-audit/


# subagent-driven-development scratch (progress ledger, task briefs, review packages)
.superpowers/

# environment files (never commit secrets)
.env
.env.*

# AI assistant local/scratch files
CLAUDE.local.md
.claude/settings.local.json
.claude/worktrees/
.agents/

# non-npm lockfiles are forbidden (npm-only repo)
# npm is this project's package manager (AGENTS.md); package-lock.json is the committed lockfile.
# Something on developer machines periodically runs pnpm here, and the stray lockfile has been
# committed by accident. Detect contamination with `ls node_modules/.pnpm`, not by this file's
# presence — it has been absent during at least one occurrence.
pnpm-lock.yaml
yarn.lock

# Byte cache from the local-media Python bridge tests. It sits inside a directory that
# `tauri.conf.json` bundles recursively, so an accidental commit would ship compiled artefacts
# that nobody reviewed and that are invalid for any interpreter but the one that wrote them.
__pycache__/
*.pyc

# Desktop fixture binaries are built by the layer that uses them, never committed.
tests/desktop/fixtures/agent-mcp/*.exe
tests/desktop/fixtures/agent-mcp/*.pdb
tests/desktop/fixtures/cli/*.exe
tests/desktop/fixtures/cli/*.pdb

# Runtime binaries captured by the desktop agent-mcp layer; never commit them.
tests/desktop/fixtures/agent-mcp-support/
