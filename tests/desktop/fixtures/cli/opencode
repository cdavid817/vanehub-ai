#!/usr/bin/env node
// Stands in for a managed CLI Agent's interactive binary so the desktop CLI-terminal layer can
// exercise the real PTY round trip without a model call, a credential, or a nondeterministic
// answer. Resolved by shadowing the builtin `opencode` Agent's executable name on PATH, which
// keeps CLI profile loading, executable resolution, and PTY setup on their production paths.
//
// It must survive whatever arguments the interactive profile passes, so arguments are ignored
// rather than parsed: an unrecognized flag here would fail the layer for the wrong reason.

const READY = "VANEHUB-FIXTURE-CLI READY";
const ECHO = "VANEHUB-FIXTURE-ECHO";
const STOP = "vanehub-fixture-stop";

if (process.argv.slice(2).includes("--version")) {
  process.stdout.write("vanehub-fixture 1.0.0\n");
  process.exit(0);
}

// The readiness probes the registry declares, answered and exited rather than fallen through to
// the interactive loop. `registry.rs` runs exactly these: `doctor` for claude-code, `login status`
// for codex-cli, `auth list` for opencode, each with a bounded budget. Blocking on stdin until that
// budget expires marks the executable faulty, and launch resolution then refuses an Agent the
// management page has just listed as runnable.
//
// Matched by argument rather than by asking whether stdin is a terminal. That check looked
// equivalent and is not: an Agent terminal session is also driven over pipes, so treating every
// pipe as a probe made real sessions exit instantly, and the Loop centre tripped its error boundary
// with "Agent terminal is not connected".
if (["doctor", "login", "auth"].includes(process.argv[2])) {
  process.stdout.write(`${READY}\n`);
  process.exit(0);
}

if (process.argv.slice(2).includes("run")) {
  const prompt = process.argv.slice(2).join(" ");
  if (prompt.includes("VANEHUB_E2E_SLOW")) {
    await new Promise((resolve) => setTimeout(resolve, 1_000));
  }
  const finalText = prompt.includes("VANEHUB_E2E_OVERSIZED")
    ? "界".repeat(20_001)
    : "deterministic fixture final";
  process.stdout.write(`${JSON.stringify({
    type: "text",
    sessionID: "fixture-session",
    part: {
      id: "fixture-text",
      messageID: "fixture-message",
      sessionID: "fixture-session",
      type: "text",
      text: finalText,
    },
  })}\n`);
  process.stdout.write(`${JSON.stringify({
    type: "step_finish",
    sessionID: "fixture-session",
    part: {
      id: "fixture-finish",
      reason: "stop",
      messageID: "fixture-message",
      sessionID: "fixture-session",
      type: "step-finish",
    },
  })}\n`);
  process.exit(0);
}

process.stdout.write(`${READY}\n`);

let pending = "";
process.stdin.setEncoding("utf8");
process.stdin.on("data", (chunk) => {
  pending += chunk;
  // A PTY delivers carriage returns, not newlines, when the user presses Enter.
  const lines = pending.split(/\r\n|\r|\n/);
  pending = lines.pop() ?? "";
  for (const line of lines) {
    const content = line.trim();
    if (content === STOP) {
      process.stdout.write("VANEHUB-FIXTURE-CLI STOPPING\n");
      process.exit(0);
    }
    if (content.length > 0) process.stdout.write(`${ECHO} ${content}\n`);
  }
});
process.stdin.on("end", () => process.exit(0));
